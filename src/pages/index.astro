---
import { Image } from 'astro:assets';

import Badge from '../components/badge.astro';
import BookingForm from '../components/booking-form.astro';
import CardContent from '../components/card/card-content.astro';
import Card from '../components/card/card.astro';
import Feature from '../components/feature.astro';
import Gallery from '../components/gallery.astro';
import PricePerNight from '../components/price-per-night.astro';
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout>
  <header class="relative h-[70vh] w-full">
    <div class="absolute inset-0">
      <Image
        src="https://picsum.photos/800/500"
        alt="Luxury Beach House"
        width={800}
        height={500}
        loading="eager"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
    <div class="relative z-10 flex h-full flex-col items-center justify-center px-4 text-center text-white">
      <h1 class="mb-2 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">Oceanfront Luxury Villa</h1>
      <p class="mb-8 text-xl md:text-2xl">Experience paradise in Malibu, California</p>
    </div>
  </header>
  <main>
    <section class="border-b py-4 shadow-sm">
      <div class="container mx-auto flex flex-col items-end justify-between gap-4 px-4 md:flex-row md:items-center">
        <div class="flex flex-col items-end gap-4 md:flex-row md:items-center md:gap-8">
          <Feature>
            <span slot="label">🛏</span>
            <p slot="title" class="font-medium">4 Bedrooms</p>
          </Feature>
          <Feature>
            <span slot="label">🛁</span>
            <p slot="title" class="font-medium">3.5 Baths</p>
          </Feature>
          <Feature>
            <span slot="label">🏠</span>
            <p slot="title" class="font-medium">3,200 Sq Ft</p>
          </Feature>
        </div>
        <div>
          <PricePerNight price={75} />
        </div>
      </div>
    </section>
    <div class="container mx-auto flex flex-col gap-8 px-4 py-8 lg:flex-row lg:gap-12">
      <div class="flex flex-1 flex-col gap-12">
        <section>
          <h2 class="mb-4 text-2xl font-bold">Description</h2>
          <div class="space-y-4">
            <p>
              Welcome to this stunning oceanfront luxury villa in Malibu, California. This exquisite property offers
              breathtaking views of the Pacific Ocean and direct beach access, creating the perfect retreat for those
              seeking coastal luxury living.
            </p>
            <p>
              The home features 4 bedrooms, 3.5 bathrooms, and spans 3,200 square feet of meticulously designed living
              space. The open 3loor plan seamlessly connects the gourmet kitchen, dining area, and spacious living room,
              all with panoramic ocean views through floor-to-ceiling windows.
            </p>
            <p>
              Outside, enjoy the infinity pool overlooking the ocean, a spacious deck perfect for entertaining, and
              private steps leading directly to the beach. This property combines luxury, comfort, and an unbeatable
              location to create a truly exceptional living experience.
            </p>
          </div>
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Gallery</h2>
          <Gallery />
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Features</h2>
          <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
            <Card>
              <CardContent class="flex items-start gap-4 p-6">
                <Feature>
                  <span slot="label" class="text-xl">🏖</span>
                  <h3 slot="title" class="mb-2 text-lg font-semibold">Beachfront Access</h3>
                  <p slot="description">Direct access to a private beach with stunning ocean views</p>
                </Feature>
              </CardContent>
            </Card>
            <Card>
              <CardContent class="flex items-start gap-4 p-6">
                <Feature>
                  <span slot="label" class="text-xl">🏊</span>
                  <h3 slot="title" class="mb-2 text-lg font-semibold">Infinity Pool</h3>
                  <p slot="description">Heated infinity pool overlooking the Pacific Ocean</p>
                </Feature>
              </CardContent>
            </Card>
            <Card>
              <CardContent class="flex items-start gap-4 p-6">
                <Feature>
                  <span slot="label" class="text-xl">🐕</span>
                  <h3 slot="title" class="mb-2 text-lg font-semibold">Pet Friendly</h3>
                  <p slot="description">Bring your furry friends to enjoy the vacation with you</p>
                </Feature>
              </CardContent>
            </Card>
            <Card>
              <CardContent class="flex items-start gap-4 p-6">
                <Feature>
                  <span slot="label" class="text-xl">💻</span>
                  <h3 slot="title" class="mb-2 text-lg font-semibold">High-Speed WiFi</h3>
                  <p slot="description">Stay connected with gigabit fiber internet throughout the property</p>
                </Feature>
              </CardContent>
            </Card>
          </div>
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Amenities</h2>
          <div class="grid grid-cols-2 gap-y-4 sm:grid-cols-3 md:grid-cols-2 xl:grid-cols-3">
            <Feature>
              <span slot="label">💻</span>
              <p slot="description">High-Speed WiFi</p>
            </Feature>
            <Feature>
              <span slot="label">🏊</span>
              <p slot="description">Infinity Pool</p>
            </Feature>
            <Feature>
              <span slot="label">📺</span>
              <p slot="description">Smart TVs</p>
            </Feature>
            <Feature>
              <span slot="label">🧑‍🍳</span>
              <p slot="description">Fully Equipped Kitchen</p>
            </Feature>
            <Feature>
              <span slot="label">🏖</span>
              <p slot="description">Beach Access</p>
            </Feature>
            <Feature>
              <span slot="label">🚗</span>
              <p slot="description">Parking</p>
            </Feature>
            <Feature>
              <span slot="label">🐕</span>
              <p slot="description">Pet Friendly</p>
            </Feature>
            <Feature>
              <span slot="label">📺</span>
              <p slot="description">Home Theater</p>
            </Feature>
          </div>
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Room Tour</h2>
          <div class="overflow-hidden rounded-lg">
            <Image
              src="https://picsum.photos/800/500"
              alt="Room Tour"
              width={800}
              height={500}
              class="w-full object-contain"
            />
          </div>
          <div class="mt-8 grid grid-cols-1 gap-6 xl:grid-cols-2">
            <div>
              <h3 class="mb-4 text-xl font-semibold">Main Floor</h3>
              <div class="space-y-2">
                <Feature>
                  <Badge slot="label">Living Room</Badge>
                  <p slot="description">Open concept with ocean views</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Kitchen</Badge>
                  <p slot="description">Gourmet kitchen with island</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Dining Area</Badge>
                  <p slot="description">Seats 8 comfortably</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Master Suite</Badge>
                  <p slot="description">King bed with en-suite bathroom</p>
                </Feature>
              </div>
            </div>
            <div>
              <h3 class="mb-4 text-xl font-semibold">Second Floor</h3>
              <div class="space-y-2">
                <Feature>
                  <Badge slot="label">Bedroom 2</Badge>
                  <p slot="description">Queen bed with balcony</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Bedroom 3</Badge>
                  <p slot="description">Two twin beds</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Bedroom 4</Badge>
                  <p slot="description">Queen bed with ocean view</p>
                </Feature>
                <Feature>
                  <Badge slot="label">Shared Bathroom</Badge>
                  <p slot="description">Full bathroom with tub/shower</p>
                </Feature>
              </div>
            </div>
          </div>
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Location</h2>
          <div class="space-y-4">
            <div class="overflow-hidden rounded-lg">
              <Image
                src="https://picsum.photos/800/500"
                alt="Map"
                width={800}
                height={500}
                class="w-full object-contain"
              />
            </div>
            <Feature>
              <span slot="label">📍</span>
              <p slot="description">Malibu, California 90265, United States</p>
            </Feature>
          </div>
        </section>
        <section>
          <h2 class="mb-6 text-2xl font-bold">Neighborhood</h2>
          <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
            <div>
              <p class="mb-6">
                Located in the prestigious Malibu area, this property offers easy access to local attractions, dining,
                and shopping. Enjoy the best of coastal living with these nearby highlights:
              </p>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <Feature>
                    <span slot="label">☕</span>
                    <h3 slot="title" class="font-medium">Local Cafés</h3>
                    <p slot="description" class="text-sm">Several artisan coffee shops within walking distance</p>
                  </Feature>
                </div>
                <div class="flex items-start gap-3">
                  <Feature>
                    <span slot="label">🍴</span>
                    <h3 slot="title" class="font-medium">Fine Dining</h3>
                    <p slot="description" class="text-sm">Award-winning restaurants with ocean views</p>
                  </Feature>
                </div>
                <div class="flex items-start gap-3">
                  <Feature>
                    <span slot="label">🛍</span>
                    <h3 slot="title" class="font-medium">Shopping</h3>
                    <p slot="description" class="text-sm">Boutique shops and malls within a short drive</p>
                  </Feature>
                </div>
                <div class="flex items-start gap-3">
                  <Feature>
                    <span slot="label">🌲</span>
                    <h3 slot="title" class="font-medium">Parks & Recreation</h3>
                    <p slot="description" class="text-sm">Hiking trails and nature preserves nearby</p>
                  </Feature>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="overflow-hidden rounded-lg">
                <Image
                  src="https://picsum.photos/400/300"
                  alt="Local Beach"
                  width={400}
                  height={300}
                  class="h-full w-full object-cover transition-transform hover:scale-105"
                />
              </div>
              <div class="overflow-hidden rounded-lg">
                <Image
                  src="https://picsum.photos/400/300"
                  alt="Local Restaurant"
                  width={400}
                  height={300}
                  class="h-full w-full object-cover transition-transform hover:scale-105"
                />
              </div>
              <div class="overflow-hidden rounded-lg">
                <Image
                  src="https://picsum.photos/400/300"
                  alt="Shopping Area"
                  width={400}
                  height={300}
                  class="h-full w-full object-cover transition-transform hover:scale-105"
                />
              </div>
              <div class="overflow-hidden rounded-lg">
                <Image
                  src="https://picsum.photos/400/300"
                  alt="Hiking Trail"
                  width={400}
                  height={300}
                  class="h-full w-full object-cover transition-transform hover:scale-105"
                />
              </div>
            </div>
          </div>
        </section>
      </div>
      <aside class="lg:max-w-sm">
        <Card class="sticky top-8">
          <CardContent>
            <h3 class="mb-4 text-xl font-semibold">Book Your Stay</h3>
            <BookingForm />
          </CardContent>
        </Card>
      </aside>
    </div>
  </main>
  <footer class="border-t bg-gray-50 py-8">
    <div class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 md:flex-row md:px-6">
      <p class="text-center text-sm">© 2025 Luxury Beach Rentals. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#">Contact Us</a>
        <a href="#">Terms & Conditions</a>
        <a href="#">Privacy Policy</a>
      </div>
    </div>
  </footer>
</BaseLayout>
