---
import { storyblokEditable } from '@storyblok/astro';
import { Image } from 'astro:assets';

import Badge from '../components/badge.astro';
import Feature from '../components/feature.astro';
import type { RoomTourStoryblok } from '../types/component-types-sb';

interface Props {
  blok: RoomTourStoryblok;
}

const { blok } = Astro.props;
const image = {
  src: blok.image.filename ? `${blok.image.filename}/m/768x0` : '',
  alt: blok.image.alt,
};
---

<section {...storyblokEditable(blok)}>
  <h2 class="mb-6 text-2xl font-bold">{blok.title}</h2>
  <div class="overflow-hidden rounded-lg">
    <Image src={image.src} alt={image.alt} inferSize loading="lazy" class="w-full object-contain" />
  </div>
  <div class="mt-8 grid grid-cols-1 gap-6 xl:grid-cols-2">
    {
      blok.floors.map((blok) => {
        return (
          <div>
            <h3 class="mb-4 text-xl font-semibold">{blok.title}</h3>
            <div class="space-y-2">
              {blok.rooms.map((blok) => {
                return (
                  <Feature>
                    <Badge slot="label">{blok.label}</Badge>
                    <p slot="description">{blok.description}</p>
                  </Feature>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
