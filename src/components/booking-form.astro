---
import Button from './form/button.astro';
import Input from './form/input.astro';
import LabeledInput from './form/labeled-input.astro';
import LabeledSelect from './form/labeled-select.astro';
import LabeledTextarea from './form/labeled-textarea.astro';
import PricePerNight from './price-per-night.astro';
---

<form class="space-y-6" id="booking-form" action="" method="post">
  <div class="rounded-lg bg-blue-50 p-4">
    <div class="text-center">
      <PricePerNight price={75} />
    </div>
  </div>
  <div class="space-y-4">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="space-y-2">
        <LabeledInput type="date" id="check-in" name="check-in" label="Check In" required />
      </div>
      <div class="space-y-2">
        <LabeledInput type="date" id="check-out" name="check-out" label="Check Out" required />
      </div>
    </div>
    <div class="space-y-2">
      <LabeledSelect id="guests" name="guests" label="Guests" required>
        <option value="" disabled>Select number of guests</option>
        <option value="1">1 Guest</option>
        <option value="2">2 Guests</option>
        <option value="3">3 Guests</option>
        <option value="4">4 Guests</option>
        <option value="5">5 Guests</option>
        <option value="6">6 Guests</option>
        <option value="7">7 Guests</option>
        <option value="8">8 Guests</option>
      </LabeledSelect>
    </div>
    <div class="space-y-2">
      <LabeledInput type="text" id="name" name="name" label="Full Name" placeholder="Enter your full name" required />
    </div>
    <div class="space-y-2">
      <LabeledInput
        type="email"
        id="email"
        name="email"
        label="Email Address"
        placeholder="Enter your email"
        required
      />
    </div>
    <div class="space-y-2">
      <LabeledInput
        type="text"
        id="phone"
        name="phone"
        label="Phone Number"
        placeholder="Enter your phone number"
        required
      />
    </div>
    <div class="space-y-2">
      <LabeledTextarea
        id="special-requests"
        name="special-requests"
        label="Special Requests"
        rows="3"
        placeholder="Any special requests or requirements?"
      />
    </div>
    <div class="flex items-center gap-2">
      <Input type="checkbox" id="terms" name="terms" required />
      <label for="terms" class="cursor-pointer text-sm font-normal">
        I agree to the <a href="#" class="text-blue-600 underline"> terms and conditions </a> and <a
          href="#"
          class="text-blue-600 underline">
          cancellation policy
        </a>&nbsp;<span class="text-red-500">*</span>
      </label>
    </div>
    <p class="text-xs text-gray-500"><span class="text-red-500">*</span> Required fields.</p>
  </div>
  <Button type="submit">Book Now</Button>
  <p class="text-xs text-gray-500">
    You won't be charged yet. Payment details will be collected after booking confirmation.
  </p>
</form>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    // eslint-disable-next-line no-console
    console.log(Object.fromEntries(formData.entries()));
  });
</script>
