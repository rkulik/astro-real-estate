---
interface Props {
  copyright: string;
  links: { label: string; href: string }[];
}

const { copyright, links } = Astro.props;
---

<footer class="border-t bg-gray-50 py-8">
  <div class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 md:flex-row md:px-6">
    <p class="text-center text-sm">{copyright}</p>
    <div class="flex gap-4">
      {
        links.map((link) => {
          return <a href={link.href}>{link.label}</a>;
        })
      }
    </div>
  </div>
</footer>
