---
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'input'>;

const { class: className, ...restOfProps } = Astro.props;
const isCheckbox = restOfProps.type === 'checkbox';
---

<input
  {...restOfProps}
  class:list={[
    {
      'placeholder:text-muted-foreground block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 focus:border-blue-600 focus:ring-blue-600 focus-visible:ring-1 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50':
        !isCheckbox,
    },
    className,
  ]}
/>
