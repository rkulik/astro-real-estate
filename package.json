{
  "name": "astro-real-estate",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.2",
  "description": "Astro Real Estate is a modern, high-performance real estate website built with Astro and Storyblok",
  "author": "René Kulik <rene@kulik.io> (https://www.kulik.io/)",
  "license": "MIT",
  "homepage": "https://github.com/rkulik/astro-real-estate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkulik/astro-real-estate.git"
  },
  "bugs": {
    "url": "https://github.com/rkulik/astro-real-estate/issues"
  },
  "keywords": [
    "astro",
    "storyblok",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . -c eslint.config.mjs",
    "prepare": "husky",
    "storyblok:pull-components": "dotenv -- cross-var storyblok pull-components --space=%STORYBLOK_SPACE_ID%",
    "storyblok:generate-typescript-typedefs": "dotenv -- cross-var storyblok generate-typescript-typedefs --sourceFilePaths ./components.%STORYBLOK_SPACE_ID%.json --destinationFilePath ./src/types/component-types-sb.d.ts",
    "storyblok:update-types": "pnpm run storyblok:pull-components && pnpm run storyblok:generate-typescript-typedefs"
  },
  "dependencies": {
    "@storyblok/astro": "^6.1.1",
    "@storyblok/js": "^3.4.0",
    "@storyblok/richtext": "^3.2.0",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^5.7.5",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@rkulik/eslint-config": "^1.6.0",
    "@rkulik/prettier-config": "^1.1.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "cross-var": "^1.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.25.1",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3"
  }
}
